{
  "name": "react-hydration-comparator",
  "version": "1.0.0",
  "description": "Compare server HTML vs post-hydration DOM for React hydration mismatches (#418/#423)",
  "type": "module",
  "main": "dist/core/index.js",
  "bin": {
    "react-hydrate-cmp": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc && node -e \"import('node:fs').then(fs=>fs.cpSync('src/web/public','dist/web/public',{recursive:true}))\"",
    "start:web": "node dist/web/server.js",
    "dev:web": "tsx src/web/server.ts",
    "dev:cli": "tsx src/cli/index.ts",
    "test": "tsx --test test/*.test.ts",
    "test:watch": "tsx --test --watch test/*.test.ts",
    "test:e2e": "tsx --test test/e2e/*.e2e.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "react",
    "hydration",
    "ssr",
    "playwright"
  ],
  "license": "MIT",
  "dependencies": {
    "commander": "^12.1.0",
    "express": "^4.21.2",
    "kleur": "^4.1.5",
    "parse5": "^7.2.1",
    "playwright": "^1.49.1",
    "undici": "^7.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
